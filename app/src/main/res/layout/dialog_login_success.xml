<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="270dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="18dp"
    app:cardElevation="8dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp">

        <!-- Animated Center Badge Container (Small & Compact) -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">

            <!-- State 1: Custom Small Circular Loader -->
            <ProgressBar
                android:id="@+id/pb_login_loader"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="#10B981"
                android:visibility="gone" />

            <!-- State 2: Success Badge Ring with Checkmark (Small & Compact) -->
            <FrameLayout
                android:id="@+id/layout_success_badge"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_success_icon_circle">

                <ImageView
                    android:id="@+id/iv_success_check"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="Success"
                    android:src="@drawable/ic_check"
                    app:tint="#10B981" />
            </FrameLayout>
        </FrameLayout>

        <!-- Dialog Title (Small) -->
        <TextView
            android:id="@+id/tv_dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.01"
            android:text="Login Successful"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Personalized Welcome Message (Small) -->
        <TextView
            android:id="@+id/tv_dialog_welcome_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:text="Welcome, Agent"
            android:textColor="#10B981"
            android:textSize="12.5sp" />

        <!-- Backend or Status Subtitle Message (Small) -->
        <TextView
            android:id="@+id/tv_dialog_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:text="Authenticated successfully"
            android:textColor="#64748B"
            android:textSize="11.5sp" />

        <!-- Agent & Station Details Info Card (Compact) -->
        <LinearLayout
            android:id="@+id/layout_login_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_status_info_box"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <!-- Station Location Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="Location"
                    android:src="@drawable/ic_location"
                    app:tint="#10B981" />

                <TextView
                    android:id="@+id/tv_dialog_station_location"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="Station: Kolkata Central"
                    android:textColor="#334155"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:background="#E2E8F0" />

            <!-- Terminal / Device Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="Terminal"
                    android:src="@drawable/ic_terminal"
                    app:tint="#64748B" />

                <TextView
                    android:id="@+id/tv_dialog_device_info"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="Terminal: POS-0020797790"
                    android:textColor="#64748B"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Redirecting Indicator with Mini Progress Bar (Small) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/pb_redirect_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="110dp"
                android:layout_height="3dp"
                android:indeterminate="true"
                android:indeterminateTint="#10B981" />

            <TextView
                android:id="@+id/tv_redirect_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:text="Redirecting..."
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Optional Instant Continue Button (Small) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dialog_continue"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#0F172A"
            android:elevation="1dp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.01"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="Continue"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12.5sp"
            app:cornerRadius="10dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

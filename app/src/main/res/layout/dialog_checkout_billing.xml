<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="24dp"
    app:cardElevation="10dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="22dp">

            <!-- Top Header Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="Vehicle Check-Out"
                        android:textColor="#0F172A"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_checkout_slot_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        tools:text="Two Wheeler • Slot 2W-002" />
                </LinearLayout>

                <!-- Vehicle Number Pill -->
                <TextView
                    android:id="@+id/tv_checkout_vehicle_no"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_soft"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.04"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:textColor="#2563EB"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="WB02AB1234" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"
                android:background="#F1F5F9" />

            <!-- Bill Breakdown Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_checkout_bill_card"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- In Time -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif"
                        android:text="Check-In Time"
                        android:textColor="#64748B"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/tv_checkout_in_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#0F172A"
                        android:textSize="12.5sp"
                        tools:text="07 Sep, 02:30 PM" />
                </LinearLayout>

                <!-- Out Time -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif"
                        android:text="Check-Out Time"
                        android:textColor="#64748B"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/tv_checkout_out_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#0F172A"
                        android:textSize="12.5sp"
                        tools:text="07 Sep, 04:45 PM" />
                </LinearLayout>

                <!-- Duration -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif"
                        android:text="Parking Duration"
                        android:textColor="#64748B"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/tv_checkout_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="#0F172A"
                        android:textSize="12.5sp"
                        tools:text="3 Hour(s)" />
                </LinearLayout>

                <!-- Tariff Rate -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif"
                        android:text="Tariff Rate"
                        android:textColor="#64748B"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/tv_checkout_rate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#0F172A"
                        android:textSize="12.5sp"
                        tools:text="₹10.00 / hr" />
                </LinearLayout>

                <!-- Fine Amount (if any) -->
                <LinearLayout
                    android:id="@+id/layout_checkout_fine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif"
                        android:text="Fine / Penalty"
                        android:textColor="#DC2626"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/tv_checkout_fine"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="#DC2626"
                        android:textSize="12.5sp"
                        tools:text="₹50.00" />
                </LinearLayout>
            </LinearLayout>

            <!-- Total Amount Due Highlight Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_chip_soft"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:letterSpacing="0.04"
                        android:text="TOTAL PAYABLE"
                        android:textColor="#64748B"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFamily="sans-serif"
                        android:text="Select payment method"
                        android:textColor="#94A3B8"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_checkout_total_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:textColor="#0F172A"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    tools:text="₹30.00" />
            </LinearLayout>

            <!-- Payment Methods Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="sans-serif-bold"
                android:text="CHOOSE PAYMENT METHOD"
                android:textColor="#475569"
                android:textSize="11.5sp" />

            <!-- Payment Buttons (Cash, Card, UPI) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1. Cash Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pay_cash"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_btn_pay_cash"
                    android:elevation="2dp"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.02"
                    android:text="💵  Cash Payment"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14.5sp"
                    app:backgroundTint="@null"
                    app:cornerRadius="14dp" />

                <!-- 2. Card Payment (POS) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pay_card"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_btn_pay_card"
                    android:elevation="2dp"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.02"
                    android:text="💳  Card Payment"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14.5sp"
                    app:backgroundTint="@null"
                    app:cornerRadius="14dp" />

                <!-- 3. UPI / Dynamic QR (POS) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pay_upi"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_btn_pay_upi"
                    android:elevation="2dp"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.02"
                    android:text="📱  UPI / QR Code"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14.5sp"
                    app:backgroundTint="@null"
                    app:cornerRadius="14dp" />

                <!-- Cancel Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_cancel_checkout"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Cancel &amp; Keep Parked"
                    android:textAllCaps="false"
                    android:textColor="#64748B"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</com.google.android.material.card.MaterialCardView>

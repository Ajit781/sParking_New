<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="28dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- Glowing Status Icon Badge -->
    <FrameLayout
        android:id="@+id/layout_status_badge"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:background="@drawable/bg_warning_icon_circle">

        <ImageView
            android:id="@+id/iv_status_icon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:contentDescription="Status Icon"
            android:src="@drawable/ic_alert_circle"
            app:tint="#D97706" />
    </FrameLayout>

    <!-- Dialog Title -->
    <TextView
        android:id="@+id/tv_status_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.01"
        android:text="Payment Cancelled"
        android:textColor="#0F172A"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Subtitle / Friendly Message -->
    <TextView
        android:id="@+id/tv_status_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="Transaction was aborted on the POS terminal."
        android:textColor="#475569"
        android:textSize="13.5sp" />

    <!-- Details Box -->
    <LinearLayout
        android:id="@+id/layout_status_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_status_info_box"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_status_guard_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_lock"
                app:tint="#16A34A" />

            <TextView
                android:id="@+id/tv_status_guard_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-bold"
                android:text="Vehicle Remains Parked"
                android:textColor="#16A34A"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_status_reason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="2dp"
            android:text="No charges deducted. You can retry checkout anytime."
            android:textColor="#64748B"
            android:textSize="12.5sp" />
    </LinearLayout>

    <!-- Action Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_status_ok"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="#0F172A"
            android:elevation="2dp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.02"
            android:text="Understood"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14.5sp"
            app:cornerRadius="14dp" />
    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="26dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- Glowing Success Icon Badge -->
    <FrameLayout
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:background="@drawable/bg_success_icon_circle">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:contentDescription="Success Icon"
            android:src="@drawable/ic_check"
            app:tint="#16A34A" />
    </FrameLayout>

    <!-- Dialog Title -->
    <TextView
        android:id="@+id/tv_success_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.01"
        android:text="Check-Out Successful"
        android:textColor="#0F172A"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tv_success_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="Vehicle has exited the parking station"
        android:textColor="#64748B"
        android:textSize="13sp" />

    <!-- Vehicle Number Plate Capsule -->
    <TextView
        android:id="@+id/tv_success_vehicle_no"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_pill_input"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.06"
        android:paddingStart="18dp"
        android:paddingTop="7dp"
        android:paddingEnd="18dp"
        android:paddingBottom="7dp"
        android:text="WB 02 AB 1234"
        android:textColor="#0F172A"
        android:textSize="16sp" />

    <!-- Receipt Details Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_receipt_summary_card"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Row 1: Amount & Duration -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="Amount Paid"
                    android:textColor="#64748B"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/tv_success_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-black"
                    android:text="₹40.00"
                    android:textColor="#16A34A"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="Duration"
                    android:textColor="#64748B"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/tv_success_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="2 Hr(s)"
                    android:textColor="#1E293B"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="#E2E8F0" />

        <!-- Row 2: Payment Mode & Slot/Booking -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="Payment Method"
                    android:textColor="#64748B"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/tv_success_payment_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="CASH"
                    android:textColor="#0F172A"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="Assigned Slot"
                    android:textColor="#64748B"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/tv_success_slot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="General"
                    android:textColor="#0F172A"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 3: Transaction Ref (conditional) -->
        <TextView
            android:id="@+id/tv_success_txn_ref"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_chip_soft"
            android:ellipsize="middle"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="Txn Ref: 1002938129"
            android:textColor="#475569"
            android:textSize="11.5sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Printing Status Feedback Note -->
    <TextView
        android:id="@+id/tv_print_feedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:textColor="#16A34A"
        android:textSize="12.5sp"
        android:visibility="gone" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="vertical">

        <!-- Print Receipt Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_print_receipt"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="@color/primary"
            android:elevation="3dp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.02"
            android:text="🖨️   Print Receipt Ticket"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14.5sp"
            app:cornerRadius="14dp" />

        <!-- Done / Close Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_done_checkout"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-bold"
            android:text="Done / Close"
            android:textAllCaps="false"
            android:textColor="#64748B"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>

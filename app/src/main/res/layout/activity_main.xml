<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    tools:context=".MainActivity">

    <!-- Primary Screen Coordinator Layout -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/main_coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F8FAFC">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Premium Elevated Modern Navbar with Rich Royal Gradient -->
            <LinearLayout
                android:id="@+id/navbar_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_appbar_gradient"
                android:elevation="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Hamburger Menu Button -->
                <ImageButton
                    android:id="@+id/btn_menu"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_nav_icon_button"
                    android:contentDescription="Open Menu"
                    android:padding="9dp"
                    android:src="@drawable/ic_menu"
                    app:tint="@color/white" />

                <!-- App Logo -->
                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="sParking Logo"
                    android:src="@drawable/ic_parking_logo" />

                <!-- Brand Title & Subtitle / Location / Date-Time -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_navbar_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="sParking"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_navbar_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:textColor="#BFDBFE"
                        android:textSize="11sp"
                        tools:text="Location • Agent Name" />

                    <TextView
                        android:id="@+id/tv_navbar_datetime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:textColor="#34D399"
                        android:textSize="10.5sp"
                        tools:text="Mon, 07 Sep 2026 • 02:30 PM" />
                </LinearLayout>

                <!-- Live Status Indicator Pill -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_navbar_pill_dark"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="9dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp">

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/bg_online_dot" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="ONLINE"
                        android:textColor="#34D399"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Refresh Button -->
                <ImageButton
                    android:id="@+id/btn_refresh"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_nav_icon_button"
                    android:contentDescription="Refresh Vehicles"
                    android:padding="10dp"
                    android:src="@drawable/ic_refresh"
                    app:tint="@color/white" />

            </LinearLayout>

            <!-- Main Dashboard Container -->
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:paddingBottom="96dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/navbar_layout">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Modern Search Bar Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_search_bar"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="14dp"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:strokeColor="#E2E8F0"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="14dp"
                            android:paddingEnd="10dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:contentDescription="Search Icon"
                                android:src="@drawable/ic_search"
                                app:tint="#64748B" />

                            <EditText
                                android:id="@+id/et_search_vehicles"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="10dp"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:background="@null"
                                android:fontFamily="sans-serif-medium"
                                android:hint="Search vehicle number, slot, phone..."
                                android:imeOptions="actionSearch"
                                android:inputType="textCapCharacters"
                                android:maxLines="1"
                                android:textColor="@color/text_primary"
                                android:textColorHint="#94A3B8"
                                android:textSize="14sp" />

                            <ImageView
                                android:id="@+id/btn_clear_search"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="?android:attr/selectableItemBackgroundBorderless"
                                android:contentDescription="Clear Search"
                                android:padding="6dp"
                                android:src="@drawable/ic_close"
                                android:visibility="gone"
                                app:tint="#94A3B8" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Section Title & Swipe Instruction -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:text="Checked-In Vehicles"
                                android:textColor="@color/text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="Swipe right or tap Checkout to exit"
                                android:textColor="#059669"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_vehicles_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_count_badge"
                            android:fontFamily="sans-serif-bold"
                            android:paddingStart="12dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="5dp"
                            android:text="0 in lot"
                            android:textColor="@color/primary"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                    <!-- Modern Loading Progress State -->
                    <LinearLayout
                        android:id="@+id/layout_loading_vehicles"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="36dp"
                        android:paddingBottom="36dp"
                        android:visibility="gone">

                        <FrameLayout
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:background="@drawable/bg_success_icon_circle">

                            <ProgressBar
                                android:id="@+id/progress_vehicles"
                                style="?android:attr/progressBarStyle"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_gravity="center"
                                android:indeterminateTint="@color/primary" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="Loading Active Vehicles..."
                            android:textColor="#0F172A"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif"
                            android:text="Syncing lot status with station"
                            android:textColor="#64748B"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                    <!-- Clean Normal Empty State View -->
                    <LinearLayout
                        android:id="@+id/layout_empty_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="54dp"
                        android:paddingBottom="54dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <!-- Clean Icon Circle Badge -->
                        <FrameLayout
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            android:background="@drawable/bg_empty_icon_circle">

                            <ImageView
                                android:id="@+id/iv_empty_icon"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_gravity="center"
                                android:contentDescription="Empty Lot"
                                android:src="@drawable/ic_directions_car"
                                app:tint="#3B82F6" />
                        </FrameLayout>

                        <!-- Empty Title -->
                        <TextView
                            android:id="@+id/tv_empty_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="No Checked-In Vehicles"
                            android:textColor="#0F172A"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <!-- Empty Subtitle -->
                        <TextView
                            android:id="@+id/tv_empty_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:fontFamily="sans-serif"
                            android:gravity="center"
                            android:text="Tap the Check In button below to issue tickets"
                            android:textColor="#64748B"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- RecyclerView for Checked-In Vehicles -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_parked_vehicles"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/item_parked_vehicle" />

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Floating Action Button '+' For Check In -->
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fab_check_in"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="@color/primary"
            android:fontFamily="sans-serif-bold"
            android:text="Check In"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:elevation="6dp"
            app:icon="@drawable/ic_add"
            app:iconTint="@color/white" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Side Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="310dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/white"
        android:fitsSystemWindows="false"
        app:elevation="16dp"
        app:headerLayout="@layout/nav_header_main"
        app:itemIconPadding="16dp"
        app:itemIconSize="22dp"
        app:itemIconTint="@color/primary"
        app:itemTextColor="@color/text_primary"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="26dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- Glowing Warning / Unregistered Badge -->
    <FrameLayout
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:background="@drawable/bg_warning_icon_circle">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:contentDescription="Unregistered Vehicle Icon"
            android:src="@drawable/ic_alert_circle"
            app:tint="#D97706" />
    </FrameLayout>

    <!-- Dialog Title -->
    <TextView
        android:id="@+id/tv_unreg_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.01"
        android:text="Vehicle Not Registered"
        android:textColor="#0F172A"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tv_unreg_dialog_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="No active registration found for this vehicle"
        android:textColor="#64748B"
        android:textSize="13sp" />

    <!-- Vehicle Number Plate Capsule -->
    <TextView
        android:id="@+id/tv_unreg_dialog_vehicle_no"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_pill_input"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.06"
        android:paddingStart="18dp"
        android:paddingTop="7dp"
        android:paddingEnd="18dp"
        android:paddingBottom="7dp"
        android:text="DL 01 AB 1234"
        android:textColor="#0F172A"
        android:textSize="16sp" />

    <!-- Explanatory Details Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_receipt_summary_card"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tv_unreg_dialog_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="This vehicle is not registered in the system.\nWould you like to register it now and generate a check-in ticket?"
            android:textColor="#334155"
            android:textSize="13.5sp" />
    </LinearLayout>

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <!-- Cancel / Re-enter Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_unreg"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="#F1F5F9"
            android:fontFamily="sans-serif-bold"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="#475569"
            android:textSize="14sp"
            app:cornerRadius="14dp" />

        <!-- Confirm / Proceed to Register Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm_register"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1.4"
            android:backgroundTint="#10B981"
            android:elevation="3dp"
            android:fontFamily="sans-serif-bold"
            android:text="OK, Register"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_arrow_forward"
            app:iconGravity="textEnd"
            app:iconTint="@color/white" />
    </LinearLayout>

</LinearLayout>
